# Local development only. Copy to .env and replace the admin passphrase before starting Compose.
POSTGRES_DB=portroyal
POSTGRES_USER=portroyal
POSTGRES_PASSWORD=change-this-local-database-password
PORTROYAL_AUTH_ISSUER=http://localhost:8080
PORTROYAL_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORTROYAL_WEB_REDIRECT_URIS=http://localhost:3000/auth/callback
PORTROYAL_WEB_LOGOUT_REDIRECT_URIS=http://localhost:3000/
PORTROYAL_BOOTSTRAP_ADMIN_ENABLED=true
PORTROYAL_INITIAL_ADMIN_PASSWORD=
