# Copy to .env.production on the production host, restrict its permissions, and fill every value.
# Never commit the populated file. Preserve the exact existing PostgreSQL Docker volume name.
POSTGRES_DB=prdb
POSTGRES_USER=replace_database_user
POSTGRES_PASSWORD=replace_with_database_secret
POSTGRES_VOLUME_NAME=replace_with_existing_docker_volume_name
POSTGRES_INIT_SCHEMA_FILE=./portroyal_be/schema.sql
EMAIL_WORKER_BUILD_CONTEXT=../email_sender_bot
BE_APP_LOG_DIR=/var/log/portroyal-be

PORTROYAL_AUTH_ISSUER=https://api.example.com
PORTROYAL_AUTH_KEYSTORE_FILE=/secure/path/portroyal-auth.p12
PORTROYAL_AUTH_KEYSTORE_PASSWORD=replace_with_keystore_password
PORTROYAL_AUTH_KEY_ALIAS=portroyal-signing
PORTROYAL_AUTH_PUBLIC_KEY_ALIASES=
PORTROYAL_API_ALLOWED_ORIGINS=https://app.example.com
PORTROYAL_WEB_REDIRECT_URIS=https://app.example.com/auth/callback
PORTROYAL_WEB_LOGOUT_REDIRECT_URIS=https://app.example.com/
PORTROYAL_BOT_CLIENT_SECRET=replace_with_bot_client_secret
PORTROYAL_CALLBACK_ENCRYPTION_KEY=replace_with_base64_32_random_bytes
PORTROYAL_CALLBACK_ENCRYPTION_KEY_ID=current
PORTROYAL_CALLBACK_PREVIOUS_ENCRYPTION_KEYS=
PORTROYAL_BOOTSTRAP_ADMIN_ENABLED=false
PORTROYAL_INITIAL_ADMIN_PASSWORD=

MJ_APIKEY_PUBLIC=replace_with_mailjet_public_key
MJ_APIKEY_PRIVATE=replace_with_mailjet_private_key
SENDER_EMAIL=notifications@example.com
SENDER_NAME=Port Royal
CHECK_PERIOD_SECONDS=10
MAX_EMAILS_PER_DAY=1000
EMAIL_SENDING_BOT_ENABLED=true
HEALTH_CHECK_EMAIL_RECIPIENT=ops@example.com
